//// Translated UI strings and quick-topic prompts. EN/JP were ported 1:1 from
//// the `translations` object in the old `public/script.js`; TR was added
//// natively in the Lustre port.

pub type Language {
  En
  Jp
  Tr
}

pub type Strings {
  Strings(
    construct_title: String,
    construct_subline: String,
    status_ready: String,
    status_thinking: String,
    status_writing: String,
    status_speaking: String,
    voice_on: String,
    voice_off: String,
    voice_label: String,
    // The toggle in the bar shows `voice_short`: on or off.
    voice_short: String,
    send: String,
    send_label: String,
    language_label: String,
    switch_to_en: String,
    switch_to_jp: String,
    switch_to_tr: String,
    nav_label: String,
    // The scheme switch reads `scheme_before` + the scheme it switches to +
    // `scheme_after`; only the scheme's name is visible.
    scheme_before: String,
    scheme_after: String,
    scheme_light: String,
    scheme_dark: String,
    conversation_label: String,
    welcome_msg: String,
    input_placeholder: String,
    try_asking: String,
    disclaimer: String,
    family_label: String,
    error_rate_limited: String,
    error_offline: String,
    error_timeout: String,
    // Shown above every error line, so an error is never told by colour alone.
    error_label: String,
    who_you: String,
    who_construct: String,
    btn_experience: String,
    btn_education: String,
    btn_skills: String,
    btn_visa: String,
    btn_about_bot: String,
    prompt_experience: String,
    prompt_education: String,
    prompt_skills: String,
    prompt_visa: String,
    prompt_about_bot: String,
  )
}

